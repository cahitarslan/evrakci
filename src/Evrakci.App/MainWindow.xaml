<ui:FluentWindow x:Class="Evrakci.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Evrakci.App.Views"
                 Title="{Binding Title}"
                 Width="1200" Height="840" MinWidth="980" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized" FontSize="15"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Evrakci;component/Assets/evrakci.ico">
    <ui:FluentWindow.Resources>
        <Style x:Key="Tab" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Evrakci;component/Assets/evrakci.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="20,2,20,10" MinHeight="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Outside a file: the two areas of the app -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsCase, Converter={StaticResource InverseBoolToVisibility}}">
                <ToggleButton Style="{StaticResource Tab}" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding HomeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock Text="Dosyalarım" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Tab}" IsChecked="{Binding IsTemplates, Mode=OneWay}" Command="{Binding TemplatesCommand}"
                              ToolTip="Şablon setlerini görüntüle, kopyala ve düzenle">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Library24" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock Text="Şablonlar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <!-- Inside a file: back, file name, save state -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsCase, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft24}" Content="Dosyalarım" Padding="8,6" Margin="0,0,12,0"
                           Command="{Binding HomeCommand}" ToolTip="Dosya listesine dön (her şey kaydedildi)" />
                <StackPanel VerticalAlignment="Center" MaxWidth="240">
                    <TextBlock Text="{Binding CaseTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CaseTitle}" />
                    <TextBlock Text="{Binding SaveState}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="Yazdıklarınız kendiliğinden kaydedilir" />
                </StackPanel>
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding Steps}" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding IsCase, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle x:Name="Line" Width="18" Height="1" Margin="2,0" VerticalAlignment="Center"
                                       Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Button Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Cursor="Hand" Padding="6,4"
                                    Background="Transparent" BorderThickness="0" ToolTip="{Binding Title}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="32" Height="32">
                                        <Ellipse x:Name="Circle" Fill="{DynamicResource ControlFillColorSecondaryBrush}"
                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                                        <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:SymbolIcon x:Name="Check" Symbol="Checkmark24" FontSize="14" Visibility="Collapsed"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="Label" Text="{Binding Title}" Margin="8,0,0,0" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Number}" Value="1">
                                <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Güncellemeyi yükle" Margin="0,0,6,0"
                           Command="{Binding InstallUpdateCommand}" ToolTip="Yeni sürüm indirildi. Uygulama kapanıp yeni sürümle açılır; yazdıklarınız kaydedilir."
                           Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button x:Name="FileMenuButton" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="OnMenuClick" Margin="0,0,6,0"
                           ToolTip="Dosya işlemleri" Visibility="{Binding IsCase, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Yeniden adlandır…" Command="{Binding RenameFileCommand}" />
                            <MenuItem Header="Dışa aktar (başka bilgisayar için)…" Command="{Binding ExportFileCommand}" />
                            <Separator />
                            <MenuItem Header="Dosyayı sil…" Command="{Binding DeleteCurrentFileCommand}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ui:Button x:Name="ThemeButton" Icon="{ui:SymbolIcon DarkTheme24}" ToolTip="Tema: açık / koyu" Click="OnMenuClick">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Sistemle aynı" IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                                      Command="{Binding SetThemeCommand}" CommandParameter="Sistem" />
                            <MenuItem Header="Açık" IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                                      Command="{Binding SetThemeCommand}" CommandParameter="Açık" />
                            <MenuItem Header="Koyu" IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                                      Command="{Binding SetThemeCommand}" CommandParameter="Koyu" />
                            <Separator />
                            <MenuItem Header="Kaynak kodu ve hata bildirimi (GitHub)…" Command="{Binding OpenSourceCommand}" />
                            <MenuItem Header="{Binding VersionText}" IsEnabled="False" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Border Grid.Row="2" Margin="12,0,12,0" CornerRadius="8,8,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The brand's double margin rule, as on a petition sheet (the logo): the content area is the page. -->
            <Grid Opacity="0.55">
                <Rectangle HorizontalAlignment="Left" Margin="7,0,0,0" Width="1.5" Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Rectangle HorizontalAlignment="Left" Margin="11,0,0,0" Width="1.5" Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Grid>
            <Grid Grid.Column="1">
                <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}" />
                <views:SetStepView Visibility="{Binding IsTemplates, Converter={StaticResource BoolToVisibility}}" />
                <Grid Visibility="{Binding IsCase, Converter={StaticResource BoolToVisibility}}">
                    <views:DocumentsStepView Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=1}" />
                    <views:FormStepView Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=2}" />
                    <views:PreviewStepView Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=3}" />
                    <views:GenerateStepView Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter=4}" />
                </Grid>
            </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="12,0,12,12" Padding="16,10" CornerRadius="0,0,8,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="Geri" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding BackCommand}" MinWidth="100"
                           Visibility="{Binding IsCase, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="16,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource Subtle}" TextWrapping="NoWrap" />
                <ui:Button Grid.Column="2" Appearance="Primary" MinWidth="140" Command="{Binding NextCommand}"
                           Visibility="{Binding ShowNext, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NextText}" VerticalAlignment="Center" />
                        <ui:SymbolIcon Symbol="ArrowRight24" Margin="8,0,0,0" />
                    </StackPanel>
                </ui:Button>
                <TextBlock Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Subtle}" FontSize="14"
                           Text="Dosyalarınız ve yazdığınız bilgiler bu bilgisayarda kalır; hiçbiri internete gönderilmez."
                           Visibility="{Binding IsCase, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
