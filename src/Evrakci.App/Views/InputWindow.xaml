<ui:FluentWindow x:Class="Evrakci.App.Views.InputWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="480" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,4,24,20">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Message" Margin="0,6,0,0" Style="{StaticResource Subtle}" />
            <TextBlock x:Name="InputLabel" Margin="0,14,0,4" />
            <ui:TextBox x:Name="Input" ClearButtonEnabled="False" TextWrapping="Wrap" AcceptsReturn="False" />
            <ComboBox x:Name="Choice" Margin="0,10,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="Error" Margin="0,6,0,0" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

            <StackPanel x:Name="ScopePanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Text="Nerede uygulansın?" FontWeight="SemiBold" Margin="0,0,0,6" />
                <RadioButton x:Name="ScopeHere" GroupName="Scope" IsChecked="True" Content="Yalnızca seçilen yerde" Margin="0,0,0,4" />
                <RadioButton x:Name="ScopeDoc" GroupName="Scope" Margin="0,0,0,4" />
                <RadioButton x:Name="ScopeSet" GroupName="Scope" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button x:Name="OkButton" Appearance="Primary" Click="OnOk" Margin="0,0,8,0" IsDefault="True" />
                <ui:Button Content="Vazgeç" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
