<UserControl x:Class="Evrakci.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <Grid Margin="32,24,32,20" MaxWidth="1000">

        <!-- My files -->
        <DockPanel Visibility="{Binding ShowFiles, Converter={StaticResource BoolToVisibility}}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="Dosyalarım" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowImport24}" Content="İçe aktar" Margin="0,0,6,0"
                               Command="{Binding ImportFileCommand}" ToolTip="Başka bilgisayardan dışa aktarılmış bir .evrak dosyasını ekle" />
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Yeni dosya" Padding="16,8"
                               Command="{Binding NewFileCommand}" />
                </StackPanel>
            </Grid>
            <ui:TextBox DockPanel.Dock="Top" Margin="0,0,0,12" PlaceholderText="Dosya ara…" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}" />

            <Grid>
                <!-- Empty -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding NoFiles, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Henüz dosya yok" Style="{StaticResource SectionTitle}" FontSize="22" HorizontalAlignment="Center" />
                    <TextBlock Text="İlk arabuluculuk dosyanızı başlatın; yazdıklarınız kendiliğinden kaydedilir."
                               Style="{StaticResource Subtle}" FontSize="14" TextAlignment="Center" Margin="0,6,0,18" />
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Yeni dosya" Padding="20,10"
                               HorizontalAlignment="Center" Command="{Binding NewFileCommand}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <ui:CardAction Padding="16,12,56,12" IsChevronVisible="False" Icon="{ui:SymbolIcon DocumentText24}"
                                                   Command="{Binding DataContext.OpenFileCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding SetName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Status, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Modified, StringFormat='dd.MM.yyyy HH:mm'}" />
                                        </Grid>
                                    </ui:CardAction>
                                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="8"
                                               Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" ToolTip="Dosyayı sil"
                                               Command="{Binding DataContext.DeleteFileCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- New file: choose the kind -->
        <DockPanel Visibility="{Binding PickingType, Converter={StaticResource BoolToVisibility}}">
            <!-- The instruction is the headline: what the user has to do on this screen -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft24}" Padding="8" Margin="0,0,12,0" VerticalAlignment="Top"
                           Command="{Binding CancelPickCommand}" ToolTip="Vazgeç" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Yeni dosya" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ui:SymbolIcon Symbol="CursorClick24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Dosyanın türünü seçin" Style="{StaticResource DisplayTitle}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Margin="46,6,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Hangi uyuşmazlık için dosya açıyorsunuz? Aşağıdaki kartlardan birine tıklayın; o türün tutanakları hazırlanır." />
                </StackPanel>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LibraryGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="300" Margin="0,0,10,10">
                                        <ui:CardAction x:Name="Card" MinHeight="76" Padding="16,10" IsChevronVisible="False"
                                                       Icon="{ui:SymbolIcon Library24}" VerticalContentAlignment="Center"
                                                       Command="{Binding DataContext.PickTypeCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                       ToolTip="{Binding Entry.Description}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Entry.Category}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ui:CardAction>
                                        <ui:Button x:Name="Forget" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Padding="5"
                                                   Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" Visibility="Collapsed"
                                                   ToolTip="Listeden kaldır (klasör silinmez)"
                                                   Command="{Binding DataContext.ForgetFolderCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                                <Setter TargetName="Forget" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Card" Property="Padding" Value="16,10,44,10" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
