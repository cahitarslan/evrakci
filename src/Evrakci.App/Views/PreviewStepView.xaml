<UserControl x:Class="Evrakci.App.Views.PreviewStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="24,18,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Önizleme" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding CaseTemplatesText}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Visibility="{Binding CaseTemplatesText, Converter={StaticResource NullToVisibility}}" />
                <ListBox ItemsSource="{Binding PreviewDocuments}" SelectedItem="{Binding SelectedPreviewDocument}"
                         Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,0">
                                <ui:SymbolIcon Symbol="DocumentText24" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Entry.Template}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Icon="{ui:SymbolIcon Edit24}" Content="Şablonu düzenle" Margin="0,0,6,0"
                           Command="{Binding EditPreviewTemplateCommand}"
                           ToolTip="Bu belgenin şablonunu açar: metin seçip değişken yapabilir ya da metni değiştirebilirsiniz." />
                <ui:Button Icon="{ui:SymbolIcon Open24}" Content="Word'de aç"
                           Command="{Binding OpenInWordCommand}"
                           ToolTip="Belgeyi geçici olarak oluşturup varsayılan programda açar. Geçici dosya uygulama kapanınca silinir." />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,0,24,8">
            <ui:InfoBar IsOpen="{Binding FormIsValid, Converter={StaticResource InverseBool}}" IsClosable="False" Severity="Warning"
                        Title="Eksik bilgi var" Message="Kırmızı alanlar tamamlanınca belgeler üretilebilir." />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border Style="{StaticResource Chip}" Background="{StaticResource ValueHighlightBrush}">
                    <TextBlock Text="Değer" Foreground="{StaticResource PaperTextBrush}" FontSize="14" />
                </Border>
                <Border Style="{StaticResource Chip}" Background="{StaticResource SuffixHighlightBrush}">
                    <TextBlock Text="Ek (tıklayın)" ToolTip="Türkçe ek otomatik seçildi; düzeltmek için belgede üzerine tıklayın" Foreground="{StaticResource PaperTextBrush}" FontSize="14" />
                </Border>
                <Border Style="{StaticResource Chip}" Background="{StaticResource SuffixOverriddenBrush}">
                    <TextBlock Text="Düzeltilmiş ek" Foreground="{StaticResource PaperTextBrush}" FontSize="14" />
                </Border>
                <Border Style="{StaticResource Chip}" Background="{StaticResource MissingHighlightBrush}">
                    <TextBlock Text="Eksik alan" Foreground="{StaticResource MissingTextBrush}" FontSize="14" />
                </Border>
                <TextBlock Text="Çıkarılacak" ToolTip="Üstü çizili paragraflar boş bırakılan alan nedeniyle belgeden çıkarılır" FontSize="14" TextDecorations="Strikethrough"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Margin="24,4,24,18" CornerRadius="6" Background="{StaticResource PaperBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                MaxWidth="900" HorizontalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.12" />
            </Border.Effect>
            <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                      Background="{StaticResource PaperBrush}" />
        </Border>
    </Grid>
</UserControl>
