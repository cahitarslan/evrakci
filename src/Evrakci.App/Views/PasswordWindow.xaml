<ui:FluentWindow x:Class="Evrakci.App.Views.PasswordWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="460" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,4,24,20">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="Explain" Margin="0,6,0,14" Style="{StaticResource Subtle}" />

            <TextBlock Text="Şifre" Margin="0,0,0,4" />
            <ui:PasswordBox x:Name="First" PasswordChanged="OnChanged" />
            <StackPanel x:Name="RepeatPanel">
                <TextBlock Text="Şifre (tekrar)" Margin="0,10,0,4" />
                <ui:PasswordBox x:Name="Second" PasswordChanged="OnChanged" />
            </StackPanel>
            <TextBlock x:Name="Problem" Margin="0,8,0,0" Style="{StaticResource ErrorText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button x:Name="NoPassword" Content="Şifresiz kaydet" Click="OnNoPassword" Margin="0,0,8,0" />
                <ui:Button x:Name="Ok" Appearance="Primary" Click="OnOk" Margin="0,0,8,0" IsDefault="True" />
                <ui:Button Content="Vazgeç" IsCancel="True" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
