<UserControl x:Class="Evrakci.App.Views.FormStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <!-- Icon and words: "Boş bırak" / "Hatırla" must be understood without hovering -->
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,18,24,6">
            <Grid>
                <TextBlock Text="Tutanak bilgileri" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding FormIsValid, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding FormSummary}" VerticalAlignment="Center" Style="{StaticResource Subtle}" Margin="0,0,10,0" />
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon PinOff24}" Content="Hatırlananları sil" Command="{Binding ForgetAllCommand}"
                               ToolTip="Hatırlanan bütün bilgileri sil" />
                </StackPanel>
            </Grid>

            <!-- The documents were chosen in the first step -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:SymbolIcon Symbol="DocumentMultiple24" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding SelectedDocumentNames}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="760"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Appearance="Transparent" Content="Değiştir" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Command="{Binding GoToDocumentsCommand}" ToolTip="Hazırlanacak tutanakları değiştir" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding CaseErrors}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Error" Title="Kontrol" Message="{Binding}" Margin="0,0,0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,20">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,6">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,8" />
                            <Border Padding="18,6" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <ItemsControl ItemsSource="{Binding Fields}" KeyboardNavigation.TabNavigation="Continue">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280" />
                                                    <ColumnDefinition Width="*" MaxWidth="640" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" FontSize="16">
                                                    <TextBlock.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding TypeName}" />
                                                            <TextBlock Text="{Binding Hint}" />
                                                        </StackPanel>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>

                                                <!-- Plain input -->
                                                <ui:TextBox Grid.Column="1" Text="{Binding Raw, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="{Binding Placeholder}" IsEnabled="{Binding IsEditable}"
                                                            ClearButtonEnabled="False"
                                                            Visibility="{Binding IsPlainInput, Converter={StaticResource BoolToVisibility}}" />
                                                <!-- Money -->
                                                <Grid Grid.Column="1" Visibility="{Binding IsMoney, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Text="{Binding Raw, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Placeholder}"
                                                                IsEnabled="{Binding IsEditable}" ClearButtonEnabled="False" />
                                                    <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding Currencies}"
                                                              SelectedItem="{Binding Currency}" IsEnabled="{Binding IsEditable}" />
                                                </Grid>
                                                <!-- Date -->
                                                <!-- DatePicker.Text is one-way by default: without Mode=TwoWay the date never reaches the form -->
                                                <DatePicker Grid.Column="1" Text="{Binding Raw, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsEditable}" SelectedDateFormat="Short"
                                                            Visibility="{Binding IsDate, Converter={StaticResource BoolToVisibility}}" />
                                                <!-- Computed -->
                                                <Border Grid.Column="1" Padding="12,7" CornerRadius="4"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        Visibility="{Binding IsComputed, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="Otomatik" VerticalAlignment="Center" Style="{StaticResource Subtle}" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsBlank}"
                                                                  Visibility="{Binding CanBeBlank, Converter={StaticResource BoolToVisibility}}"
                                                                  ToolTip="Boş bırak — bu bilgi belgeye yazılmaz">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Eraser24" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <TextBlock Text="Boş bırak" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding Remember}"
                                                                  Visibility="{Binding CanRemember, Converter={StaticResource BoolToVisibility}}"
                                                                  ToolTip="Hatırla — yeni dosyalarda ve bütün setlerde otomatik dolsun">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Pin24" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <TextBlock Text="Hatırla" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="2,3,0,0">
                                                    <TextBlock Text="{Binding Output, StringFormat='→ {0}'}" FontSize="14" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding Output, Converter={StaticResource NullToVisibility}}" />
                                                    <TextBlock Text="{Binding Note}" FontSize="14" FontStyle="Italic" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                                    <TextBlock Text="{Binding VisibleError}" Style="{StaticResource ErrorText}"
                                                               Visibility="{Binding VisibleError, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
