<UserControl x:Class="Evrakci.App.Views.SetStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="More" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="ToolTip" Value="Diğer işlemler" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,20,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: template library -->
        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Şablonlar" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Yeni" Command="{Binding NewSetCommand}" Margin="0,0,4,0"
                               ToolTip="Boş bir set oluştur" />
                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenSetFolderCommand}" Margin="0,0,4,0"
                               ToolTip="Kütüphane dışındaki bir set klasörünü aç" />
                    <ui:Button Icon="{ui:SymbolIcon Folder24}" Command="{Binding OpenLibraryFolderCommand}"
                               ToolTip="{Binding LibraryRoot, StringFormat='Kütüphane klasörünü göster: {0}'}" />
                </StackPanel>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <ItemsControl ItemsSource="{Binding LibraryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,6">
                                <TextBlock Text="{Binding Name}" FontSize="14" Margin="4,4,0,4"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                            <ui:CardAction x:Name="Card" Padding="12,8" IsChevronVisible="False"
                                                           Command="{Binding DataContext.OpenLibraryItemCommand, ElementName=Root}"
                                                           CommandParameter="{Binding}" Icon="{ui:SymbolIcon Library24}" ToolTip="{Binding Folder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <Border x:Name="Badge" Grid.Column="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="13"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </ui:CardAction>
                                            <!-- A folder opened from disk: only forgotten from the list, never deleted -->
                                            <ui:Button x:Name="Forget" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Padding="6"
                                                       Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" Visibility="Collapsed"
                                                       ToolTip="Listeden kaldır (klasör silinmez)"
                                                       Command="{Binding DataContext.ForgetFolderCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                                    <Setter TargetName="Forget" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Card" Property="Padding" Value="12,8,48,8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource VariableChipBrush}" />
                                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource PaperTextBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Right: nothing chosen yet -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding HasSet, Converter={StaticResource InverseBoolToVisibility}}">
            <ui:SymbolIcon Symbol="Library24" FontSize="48" HorizontalAlignment="Left" Margin="0,0,0,12"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Bir şablon seti seçin" Style="{StaticResource SectionTitle}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Subtle}" FontSize="14"
                       Text="Bilgileri bir kez girin; Evrakçı setteki bütün belgeleri doldursun." />
        </StackPanel>

        <!-- Right: set summary -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSet, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border CornerRadius="4" Padding="8,2" Margin="0,0,6,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding SetCategory, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding SetCategory}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border CornerRadius="4" Padding="8,2" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding IsBuiltInSet, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Evrakçı ile gelir. Değiştirebilirsiniz; “Orijinaline döndür” ile ilk hâline gelir.">
                                <TextBlock Text="Hazır şablon" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SetName}" Style="{StaticResource SectionTitle}" FontSize="24" TextWrapping="Wrap"
                                   ToolTip="{Binding SetDescription}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Subtle}" ToolTip="{Binding SetFolder}">
                            <Run Text="{Binding SetDocuments.Count, Mode=OneWay}" /><Run Text=" belge · " /><Run Text="{Binding FieldCount, Mode=OneWay}" /><Run Text=" alan" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ui:Button Content="Bu türle yeni dosya" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,0,6,0"
                                   Command="{Binding NewFileFromSetCommand}" ToolTip="Bu şablon setiyle yeni bir arabuluculuk dosyası başlat" />
                        <ui:Button Content="Kopyasını oluştur" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,4,0"
                                   Command="{Binding CopySetCommand}" ToolTip="Yeni bir adla “Setlerim” altına kopyala" />
                        <ui:Button Style="{StaticResource More}" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="OnMore" Tag="{Binding}">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Yeniden adlandır…" Command="{Binding RenameSetCommand}"
                                              Visibility="{Binding IsOwnSet, Converter={StaticResource BoolToVisibility}}" />
                                    <MenuItem Header="Orijinaline döndür…" Command="{Binding RestoreSetCommand}"
                                              Visibility="{Binding IsBuiltInSet, Converter={StaticResource BoolToVisibility}}" />
                                    <MenuItem Header="Set ayarları…" Command="{Binding EditSettingsCommand}" />
                                    <MenuItem Header="Yeniden tara" Command="{Binding ReloadSetCommand}" />
                                    <MenuItem Header="Klasörü göster" Command="{Binding OpenSetInExplorerCommand}" />
                                    <Separator Visibility="{Binding IsOwnSet, Converter={StaticResource BoolToVisibility}}" />
                                    <MenuItem Header="Seti sil…" Command="{Binding DeleteSetCommand}"
                                              Visibility="{Binding IsOwnSet, Converter={StaticResource BoolToVisibility}}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Belgeler" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <ui:Button HorizontalAlignment="Right" Icon="{ui:SymbolIcon DocumentAdd24}" Content="Belge ekle" Click="OnMore" Tag="{Binding}">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Bilgisayardan (.docx, .udf)…" Command="{Binding AddDocumentCommand}" />
                                <MenuItem Header="Boş belge…" Command="{Binding NewDocumentCommand}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding SetDocuments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="12,6" CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Margin="0,0,12,0" Padding="0,2" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Format}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Note}">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{Binding Optional, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Yeni dosyada seçili gelmez; gerektiğinde formda işaretlenir.">
                                            <TextBlock Text="isteğe bağlı" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Düzenle" Icon="{ui:SymbolIcon Edit24}" Padding="10,5" Margin="0,0,2,0"
                                                   Command="{Binding DataContext.EditDocumentCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <ui:Button Style="{StaticResource More}" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="OnMore" Tag="{Binding DataContext, ElementName=Root}">
                                            <ui:Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Yeni dosyada seçili gelsin" IsChecked="{Binding IsDefault, Mode=OneWay}"
                                                              Command="{Binding PlacementTarget.Tag.ToggleOptionalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Word'de aç"
                                                              Command="{Binding PlacementTarget.Tag.OpenTemplateInWordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Yeniden adlandır…"
                                                              Command="{Binding PlacementTarget.Tag.RenameDocumentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Yukarı taşı" IsEnabled="{Binding CanMoveUp}"
                                                              Command="{Binding PlacementTarget.Tag.MoveDocumentUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Aşağı taşı" IsEnabled="{Binding CanMoveDown}"
                                                              Command="{Binding PlacementTarget.Tag.MoveDocumentDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Setten çıkar…"
                                                              Command="{Binding PlacementTarget.Tag.RemoveDocumentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </ui:Button.ContextMenu>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="set.json yok; ayarlar adlardan tahmin ediliyor. “Set ayarları” ile kaydedebilirsiniz." Margin="2,10,0,0"
                           Style="{StaticResource Subtle}" FontSize="14"
                           Visibility="{Binding SetHasNoFile, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="Icon" Symbol="Info24" FontSize="16" Margin="0,1,8,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14">
                                    <Run Text="{Binding Message, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Document, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter TargetName="Icon" Property="Symbol" Value="Warning24" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
